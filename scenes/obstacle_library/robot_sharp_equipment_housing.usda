#usda 1.0
(
    defaultPrim = "World"
    subLayers = [
        @../base.usda@
    ]
)

over "World"
{
    def Xform "Barrier" (
        prepend references = @../../assets/obstacle_library/robot/sharp_equipment_housing.usda@
    )
    {
        float xformOp:rotateZ = 0
        double3 xformOp:translate = (2.24, -0.16, 0.922)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:rotateZ"]
    }
}
