#usda 1.0
(
    defaultPrim = "World"
    subLayers = [
        @../base.usda@
    ]
)

over "World"
{
    def Xform "Barrier" (
        prepend references = @../../assets/obstacle_library/robot/steel_clamp.usda@
    )
    {
        float xformOp:rotateZ = 0
        double3 xformOp:translate = (1.82, -0.78, 0)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:rotateZ"]
    }
}
