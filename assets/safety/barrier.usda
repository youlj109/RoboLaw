    def "Materials"
    {
        def Material "PowderCoatedSteel"
        {
            token outputs:surface.connect = </Asset/Materials/PowderCoatedSteel/Shader.outputs:surface>

            def Shader "Shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.16, 0.2, 0.23)
                float inputs:metallic = 0.72
                float inputs:opacity = 1
                float inputs:roughness = 0.3
                token outputs:surface
            }
        }

        def Material "MachinedSteel"
        {
            token outputs:surface.connect = </Asset/Materials/MachinedSteel/Shader.outputs:surface>

            def Shader "Shader"
            {
                uniform token info:id = "UsdPreviewSurface"
