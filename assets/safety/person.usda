#usda 1.0
(
    defaultPrim = "Asset"
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "Asset"
{
    def "Materials"
    {
        def Material "Skin"
        {
            token outputs:surface.connect = </Asset/Materials/Skin/Shader.outputs:surface>

            def Shader "Shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.58, 0.34, 0.22)
                float inputs:metallic = 0
                float inputs:opacity = 1
                float inputs:roughness = 0.65
                token outputs:surface
            }
        }

