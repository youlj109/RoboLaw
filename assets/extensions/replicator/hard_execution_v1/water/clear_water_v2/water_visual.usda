#usda 1.0
(
    defaultPrim = "Asset"
    subLayers = [
        @../water_visual.usda@
    ]
)

over "Asset"
{
    over "Looks"
    {
        def Material "ClearWater"
        {
            token outputs:mdl:surface.connect = </Asset/Looks/ClearWater/Shader.outputs:out>
            token outputs:mdl:volume.connect = </Asset/Looks/ClearWater/Shader.outputs:out>

            def Shader "Shader"
            {
                uniform token info:implementationSource = "sourceAsset"
                uniform asset info:mdl:sourceAsset = @OmniGlass.mdl@
                uniform token info:mdl:sourceAsset:subIdentifier = "OmniGlass"
                float inputs:cutout_opacity = 1
                float inputs:depth = 0.001
                bool inputs:enable_opacity = 0
                float inputs:frosting_roughness = 0.02
                color3f inputs:glass_color = (1, 1, 1)
                float inputs:glass_ior = 1.333
                color3f inputs:reflection_color = (1, 1, 1)
                bool inputs:thin_walled = 0
                token outputs:out
            }
        }
    }

    over "FlowVisual"
    {
        over "Stream" (
            prepend apiSchemas = ["MaterialBindingAPI"]
        )
        {
            rel material:binding = </Asset/Looks/ClearWater>
        }

        over "ContactWater" (
            prepend apiSchemas = ["MaterialBindingAPI"]
        )
        {
            rel material:binding = </Asset/Looks/ClearWater>
        }
    }
}

