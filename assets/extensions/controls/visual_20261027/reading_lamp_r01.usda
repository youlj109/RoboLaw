#usda 1.0
(
    defaultPrim = "Lamp"
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "Lamp" (
    prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI"]
    doc = "Visual-only revision: weighted reading lamp with an open glass shade and visible bulb. No fracture or electrical safety model; not physically validated."
)
{
    float physics:mass = 6

    def "Materials"
    {
        def Material "SatinBlackMetal"
        {
            token outputs:surface.connect = </Lamp/Materials/SatinBlackMetal/Shader.outputs:surface>

            def Shader "Shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.055, 0.065, 0.075)
                float inputs:metallic = 0.8
                float inputs:opacity = 1
                float inputs:roughness = 0.28
                token outputs:surface
            }
        }

        def Material "BrushedBrass"
        {
            token outputs:surface.connect = </Lamp/Materials/BrushedBrass/Shader.outputs:surface>

            def Shader "Shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.55, 0.34, 0.12)
                float inputs:metallic = 0.8
                float inputs:opacity = 1
                float inputs:roughness = 0.24
                token outputs:surface
            }
        }

        def Material "FrostedGlass"
        {
            token outputs:surface.connect = </Lamp/Materials/FrostedGlass/Shader.outputs:surface>

            def Shader "Shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.6, 0.79, 0.85)
                float inputs:metallic = 0
                float inputs:opacity = 0.65
                float inputs:roughness = 0.18
                token outputs:surface
            }
        }

        def Material "WarmBulb"
        {
            token outputs:surface.connect = </Lamp/Materials/WarmBulb/Shader.outputs:surface>

            def Shader "Shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.96, 0.89, 0.68)
                color3f inputs:emissiveColor = (0.7, 0.48, 0.19)
                float inputs:metallic = 0
                float inputs:opacity = 1
                float inputs:roughness = 0.28
                token outputs:surface
            }
        }
    }

    def Cylinder "WeightedBase" (
        prepend apiSchemas = ["MaterialBindingAPI", "PhysicsCollisionAPI"]
    )
    {
        uniform token axis = "Z"
        double height = 0.035
        rel material:binding = </Lamp/Materials/SatinBlackMetal>
        double radius = 0.16
        double3 xformOp:translate = (0, 0, 0.0175)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }

    def Cylinder "BaseCollar" (
        prepend apiSchemas = ["MaterialBindingAPI", "PhysicsCollisionAPI"]
    )
    {
        uniform token axis = "Z"
        double height = 0.06
        rel material:binding = </Lamp/Materials/BrushedBrass>
        double radius = 0.032
        double3 xformOp:translate = (0, 0, 0.055)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }

    def Cylinder "Upright" (
        prepend apiSchemas = ["MaterialBindingAPI", "PhysicsCollisionAPI"]
    )
    {
        uniform token axis = "Z"
        double height = 1.16
        rel material:binding = </Lamp/Materials/SatinBlackMetal>
        double radius = 0.014
        double3 xformOp:translate = (0, 0, 0.615)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }

    def Cylinder "Arm" (
        prepend apiSchemas = ["MaterialBindingAPI", "PhysicsCollisionAPI"]
    )
    {
        uniform token axis = "Y"
        double height = 0.8
        rel material:binding = </Lamp/Materials/SatinBlackMetal>
        double radius = 0.011
        double3 xformOp:translate = (0, 0.39, 1.185)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }

    def Sphere "ElbowJoint" (
        prepend apiSchemas = ["MaterialBindingAPI", "PhysicsCollisionAPI"]
    )
    {
        rel material:binding = </Lamp/Materials/BrushedBrass>
        double radius = 0.022
        double3 xformOp:translate = (0, 0, 1.185)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }

    def Cylinder "PendantStem" (
        prepend apiSchemas = ["MaterialBindingAPI", "PhysicsCollisionAPI"]
    )
    {
        uniform token axis = "Z"
        double height = 0.09
        rel material:binding = </Lamp/Materials/BrushedBrass>
        double radius = 0.01
        double3 xformOp:translate = (0, 0.78, 1.14)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }

    def Cylinder "Socket" (
        prepend apiSchemas = ["MaterialBindingAPI", "PhysicsCollisionAPI"]
    )
    {
        uniform token axis = "Z"
        double height = 0.04
        rel material:binding = </Lamp/Materials/BrushedBrass>
        double radius = 0.026
        double3 xformOp:translate = (0, 0.78, 1.085)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }

    def Cylinder "BulbNeck" (
        prepend apiSchemas = ["MaterialBindingAPI", "PhysicsCollisionAPI"]
    )
    {
        uniform token axis = "Z"
        double height = 0.05
        rel material:binding = </Lamp/Materials/WarmBulb>
        double radius = 0.014
        double3 xformOp:translate = (0, 0.78, 1.04)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }

    def Sphere "VisibleBulb" (
        prepend apiSchemas = ["MaterialBindingAPI", "PhysicsCollisionAPI"]
    )
    {
        rel material:binding = </Lamp/Materials/WarmBulb>
        double radius = 0.025
        double3 xformOp:translate = (0, 0.78, 0.995)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }

    def Cylinder "PowerSwitch" (
        prepend apiSchemas = ["MaterialBindingAPI", "PhysicsCollisionAPI"]
    )
    {
        uniform token axis = "X"
        double height = 0.012
        rel material:binding = </Lamp/Materials/BrushedBrass>
        double radius = 0.012
        double3 xformOp:translate = (-0.018, 0, 0.65)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }

