#usda 1.0
(
    defaultPrim = "Guard"
    metersPerUnit = 1
    upAxis = "Z"
)
def Xform "Guard" (
    prepend references = @oven_corridor_guard_low.usda@
    customData = { string provenance = "Controls-local visibly padded 0.12 m deep floor-mounted crossbar; no invisible collision padding or target modifications." }
)
{
    over "Crossbar"
    {
        double3 xformOp:scale = (0.12, 0.80, 0.07)
    }
}
