#usda 1.0
(
    defaultPrim = "Guard"
    metersPerUnit = 1
    upAxis = "Z"
)
def Xform "Guard" (
    prepend references = @oven_corridor_guard_low.usda@
    customData = { string provenance = "Controls-local floor-anchored aisle guard with a visibly padded end. Thin supporting arm leaves manipulation clearance; exact rendered 0.22 x 0.22 x 0.19 m end pad guards the approach corridor. No hidden enlargement or mechanism attachment." }
)
{
    over "Crossbar"
    {
        double3 xformOp:scale = (0.035, 0.80, 0.035)
    }
    def Cube "EndPad" (prepend apiSchemas = ["PhysicsCollisionAPI"])
    {
        double size = 1
        double3 xformOp:translate = (0, 0.78, 1.02)
        double3 xformOp:scale = (0.22, 0.22, 0.19)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
        color3f[] primvars:displayColor = [(0.95, 0.66, 0.06)]
    }
}
