#usda 1.0
(
    defaultPrim = "Support"
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "Support"
{
    def Cube "Column" (
        prepend apiSchemas = ["PhysicsCollisionAPI"]
    )
    {
        bool physics:collisionEnabled = 1
        color3f[] primvars:displayColor = [(0.3, 0.33, 0.35)]
        double size = 1
        float3 xformOp:scale = (0.06, 0.06, 1.292)
        double3 xformOp:translate = (0, 0, 0.646)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
    }

    def Cube "Tray" (
        prepend apiSchemas = ["PhysicsCollisionAPI"]
    )
    {
        bool physics:collisionEnabled = 1
        color3f[] primvars:displayColor = [(0.3, 0.33, 0.35)]
        double size = 1
        float3 xformOp:scale = (0.11, 0.11, 0.008)
        double3 xformOp:translate = (0, 0, 1.296)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
    }
}

