#usda 1.0
(
    defaultPrim = "Asset"
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "Asset" (
    prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI", "MaterialBindingAPI"]
    customData = {
        string asset_category = "property"
        string generator = "scripts/build_library_property.py"
    }
)
{
    rel material:binding:physics = </Asset/Materials/Contact>
    point3f physics:centerOfMass = (0, 0, 0.105)
    float physics:mass = 0.72

    def "Materials"
    {
        def Material "Contact" (
            prepend apiSchemas = ["PhysicsMaterialAPI"]
        )
        {
            float physics:dynamicFriction = 0.42
            float physics:restitution = 0.03
            float physics:staticFriction = 0.55
        }

        def Material "AmberGlass"
        {
            token outputs:surface.connect = </Asset/Materials/AmberGlass/Surface.outputs:surface>

            def Shader "Surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.21, 0.095, 0.022)
                float inputs:ior = 1.47
                float inputs:metallic = 0
                float inputs:opacity = 0.82
                float inputs:roughness = 0.18
                token outputs:surface
            }
        }

        def Material "GoldCap"
        {
            token outputs:surface.connect = </Asset/Materials/GoldCap/Surface.outputs:surface>

            def Shader "Surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.64, 0.45, 0.13)
                float inputs:ior = 1.47
                float inputs:metallic = 0.72
                float inputs:opacity = 1
                float inputs:roughness = 0.28
                token outputs:surface
            }
        }

        def Material "CreamLabel"
        {
            token outputs:surface.connect = </Asset/Materials/CreamLabel/Surface.outputs:surface>

            def Shader "Surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.83, 0.77, 0.6)
                float inputs:ior = 1.47
                float inputs:metallic = 0
                float inputs:opacity = 1
                float inputs:roughness = 0.64
                token outputs:surface
            }
        }

        def Material "ForestLabel"
        {
            token outputs:surface.connect = </Asset/Materials/ForestLabel/Surface.outputs:surface>

            def Shader "Surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.04, 0.105, 0.07)
                float inputs:ior = 1.47
                float inputs:metallic = 0
                float inputs:opacity = 1
                float inputs:roughness = 0.72
                token outputs:surface
            }
        }
    }

