#usda 1.0
(
    defaultPrim = "Asset"
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "Asset" (
    prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI", "MaterialBindingAPI"]
    customData = {
        string asset_category = "property"
        string generator = "scripts/build_library_property.py"
    }
)
{
    rel material:binding:physics = </Asset/Materials/Contact>
    point3f physics:centerOfMass = (0, 0, 0.133)
    float physics:mass = 0.22

    def "Materials"
    {
        def Material "Contact" (
            prepend apiSchemas = ["PhysicsMaterialAPI"]
        )
        {
            float physics:dynamicFriction = 0.42
            float physics:restitution = 0.03
            float physics:staticFriction = 0.55
        }

        def Material "Crystal"
        {
            token outputs:surface.connect = </Asset/Materials/Crystal/Surface.outputs:surface>

            def Shader "Surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.79, 0.85, 0.92)
                float inputs:ior = 1.47
                float inputs:metallic = 0
                float inputs:opacity = 0.25
                float inputs:roughness = 0.08
                token outputs:surface
            }
        }

        def Material "CrystalEdge"
        {
            token outputs:surface.connect = </Asset/Materials/CrystalEdge/Surface.outputs:surface>

            def Shader "Surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.82, 0.88, 0.95)
                float inputs:ior = 1.47
                float inputs:metallic = 0
                float inputs:opacity = 0.62
                float inputs:roughness = 0.12
                token outputs:surface
            }
        }

        def Material "RedWine"
        {
            token outputs:surface.connect = </Asset/Materials/RedWine/Surface.outputs:surface>

            def Shader "Surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.23, 0.009, 0.032)
                float inputs:ior = 1.47
                float inputs:metallic = 0
                float inputs:opacity = 0.88
                float inputs:roughness = 0.18
                token outputs:surface
            }
        }
    }

