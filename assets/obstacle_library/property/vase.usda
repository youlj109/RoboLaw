#usda 1.0
(
    defaultPrim = "Asset"
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "Asset" (
    prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI", "MaterialBindingAPI"]
    customData = {
        string asset_category = "property"
        string generator = "scripts/build_library_property.py"
    }
)
{
    rel material:binding:physics = </Asset/Materials/Contact>
    point3f physics:centerOfMass = (0, 0, 0.091)
    float physics:mass = 0.68

    def "Materials"
    {
        def Material "Contact" (
            prepend apiSchemas = ["PhysicsMaterialAPI"]
        )
        {
            float physics:dynamicFriction = 0.42
            float physics:restitution = 0.03
            float physics:staticFriction = 0.55
        }

        def Material "TerracottaGlaze"
        {
            token outputs:surface.connect = </Asset/Materials/TerracottaGlaze/Surface.outputs:surface>

            def Shader "Surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.49, 0.17, 0.085)
                float inputs:ior = 1.47
                float inputs:metallic = 0
                float inputs:opacity = 1
                float inputs:roughness = 0.27
                token outputs:surface
            }
        }

        def Material "VaseInterior"
        {
            token outputs:surface.connect = </Asset/Materials/VaseInterior/Surface.outputs:surface>

            def Shader "Surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.31, 0.105, 0.055)
                float inputs:ior = 1.47
                float inputs:metallic = 0
                float inputs:opacity = 1
                float inputs:roughness = 0.46
                token outputs:surface
            }
        }

        def Material "IvoryDecoration"
        {
            token outputs:surface.connect = </Asset/Materials/IvoryDecoration/Surface.outputs:surface>

            def Shader "Surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.78, 0.68, 0.49)
                float inputs:ior = 1.47
                float inputs:metallic = 0
                float inputs:opacity = 1
                float inputs:roughness = 0.39
                token outputs:surface
            }
        }
    }

