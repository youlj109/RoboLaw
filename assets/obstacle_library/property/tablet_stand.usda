#usda 1.0
(
    defaultPrim = "Asset"
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "Asset" (
    prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI", "MaterialBindingAPI"]
    customData = {
        string asset_category = "property"
        string generator = "scripts/build_library_property.py"
    }
)
{
    rel material:binding:physics = </Asset/Materials/Contact>
    point3f physics:centerOfMass = (0, 0.018, 0.085)
    float physics:mass = 1.12

    def "Materials"
    {
        def Material "Contact" (
            prepend apiSchemas = ["PhysicsMaterialAPI"]
        )
        {
            float physics:dynamicFriction = 0.42
            float physics:restitution = 0.03
            float physics:staticFriction = 0.55
        }

        def Material "AnodizedAluminum"
        {
            token outputs:surface.connect = </Asset/Materials/AnodizedAluminum/Surface.outputs:surface>

            def Shader "Surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.26, 0.29, 0.32)
                float inputs:ior = 1.47
                float inputs:metallic = 0.85
                float inputs:opacity = 1
                float inputs:roughness = 0.28
                token outputs:surface
            }
        }

        def Material "DarkBezel"
        {
            token outputs:surface.connect = </Asset/Materials/DarkBezel/Surface.outputs:surface>

            def Shader "Surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.012, 0.016, 0.022)
                float inputs:ior = 1.47
                float inputs:metallic = 0.25
                float inputs:opacity = 1
                float inputs:roughness = 0.28
                token outputs:surface
            }
        }

        def Material "ScreenGlass"
        {
            token outputs:surface.connect = </Asset/Materials/ScreenGlass/Surface.outputs:surface>

            def Shader "Surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.012, 0.035, 0.05)
                float inputs:ior = 1.47
                float inputs:metallic = 0.12
                float inputs:opacity = 1
                float inputs:roughness = 0.12
                token outputs:surface
            }
        }

        def Material "Rubber"
        {
            token outputs:surface.connect = </Asset/Materials/Rubber/Surface.outputs:surface>

            def Shader "Surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.022, 0.025, 0.027)
                float inputs:ior = 1.47
                float inputs:metallic = 0
                float inputs:opacity = 1
                float inputs:roughness = 0.85
                token outputs:surface
            }
        }

        def Material "DisplayCyan"
        {
            token outputs:surface.connect = </Asset/Materials/DisplayCyan/Surface.outputs:surface>

            def Shader "Surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.045, 0.35, 0.44)
                color3f inputs:emissiveColor = (0.02, 0.13, 0.17)
                float inputs:ior = 1.47
                float inputs:metallic = 0
                float inputs:opacity = 1
                float inputs:roughness = 0.36
                token outputs:surface
            }
        }

        def Material "DisplayWhite"
        {
            token outputs:surface.connect = </Asset/Materials/DisplayWhite/Surface.outputs:surface>

            def Shader "Surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.7, 0.78, 0.77)
                color3f inputs:emissiveColor = (0.08, 0.09, 0.09)
                float inputs:ior = 1.47
                float inputs:metallic = 0
                float inputs:opacity = 1
                float inputs:roughness = 0.42
                token outputs:surface
            }
        }
    }

    def Cube "WeightedBase" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        rel material:binding = </Asset/Materials/AnodizedAluminum>
        double size = 1
        float3 xformOp:scale = (0.145, 0.132, 0.01)
        double3 xformOp:translate = (0, 0.018, 0.005)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
    }

    def "Colliders"
    {
        def Cube "Base" (
            prepend apiSchemas = ["PhysicsCollisionAPI"]
        )
        {
            double size = 1
            token visibility = "invisible"
            float3 xformOp:scale = (0.145, 0.132, 0.01)
            double3 xformOp:translate = (0, 0.018, 0.005)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
        }

