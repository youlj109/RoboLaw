#usda 1.0
(
    defaultPrim = "Asset"
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "Asset" (
    prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI", "MaterialBindingAPI"]
    customData = {
        string asset_category = "property"
        string generator = "scripts/build_library_property.py"
    }
)
{
    rel material:binding:physics = </Asset/Materials/Contact>
    point3f physics:centerOfMass = (0, 0, 0.085)
    float physics:mass = 0.56

    def "Materials"
    {
        def Material "Contact" (
            prepend apiSchemas = ["PhysicsMaterialAPI"]
        )
        {
            float physics:dynamicFriction = 0.42
            float physics:restitution = 0.03
            float physics:staticFriction = 0.55
        }

        def Material "ClearGlass"
        {
            token outputs:surface.connect = </Asset/Materials/ClearGlass/Surface.outputs:surface>

            def Shader "Surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.65, 0.82, 0.86)
                float inputs:ior = 1.47
                float inputs:metallic = 0
                float inputs:opacity = 0.28
                float inputs:roughness = 0.1
                token outputs:surface
            }
        }

