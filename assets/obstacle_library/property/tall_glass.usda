            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.73, 0.87, 0.91)
                float inputs:ior = 1.47
                float inputs:metallic = 0
                float inputs:opacity = 0.62
                float inputs:roughness = 0.14
                token outputs:surface
            }
        }

        def Material "StillWater"
        {
            token outputs:surface.connect = </Asset/Materials/StillWater/Surface.outputs:surface>

            def Shader "Surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.28, 0.57, 0.67)
                float inputs:ior = 1.47
                float inputs:metallic = 0
                float inputs:opacity = 0.18
                float inputs:roughness = 0.08
                token outputs:surface
            }
        }
    }

