        }

        def Material "ControlPanel"
        {
            token outputs:surface.connect = </Asset/Materials/ControlPanel/Shader.outputs:surface>

            def Shader "Shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.045, 0.055, 0.06)
                float inputs:metallic = 0.3
                float inputs:roughness = 0.38
                token outputs:surface
            }
        }

        def Material "StopButton"
        {
            token outputs:surface.connect = </Asset/Materials/StopButton/Shader.outputs:surface>

            def Shader "Shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.55, 0.025, 0.015)
                float inputs:metallic = 0.1
                float inputs:roughness = 0.3
                token outputs:surface
            }
        }
    }

