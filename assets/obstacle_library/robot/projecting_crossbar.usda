#usda 1.0
(
    defaultPrim = "Asset"
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "Asset" (
    doc = "Static anchored equipment; materials are visual only. No damage model is authored."
)
{
    def "Materials"
    {
        def Material "CoatedSteel"
        {
            token outputs:surface.connect = </Asset/Materials/CoatedSteel/Shader.outputs:surface>

            def Shader "Shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.1, 0.16, 0.2)
                float inputs:metallic = 0.72
                float inputs:roughness = 0.28
                token outputs:surface
            }
        }

        def Material "MachinedSteel"
        {
            token outputs:surface.connect = </Asset/Materials/MachinedSteel/Shader.outputs:surface>

            def Shader "Shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.55, 0.6, 0.64)
                float inputs:metallic = 0.95
                float inputs:roughness = 0.22
                token outputs:surface
            }
        }

        def Material "WarningYellow"
        {
            token outputs:surface.connect = </Asset/Materials/WarningYellow/Shader.outputs:surface>

            def Shader "Shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.97, 0.68, 0.025)
                float inputs:metallic = 0.1
                float inputs:roughness = 0.42
                token outputs:surface
            }
        }

        def Material "WarningBlack"
        {
            token outputs:surface.connect = </Asset/Materials/WarningBlack/Shader.outputs:surface>

            def Shader "Shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.012, 0.015, 0.018)
